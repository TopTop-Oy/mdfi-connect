{
  "name": "mdfi",
  "version": "0.1.1",
  "description": "Read PDFs, scans and Office files page by page through mdfi, with quality flags and CSV table export.",
  "author": {
    "name": "TopTop Oy"
  },
  "homepage": "https://mdfi.ai",
  "repository": "https://github.com/TopTop-Oy/mdfi-connect",
  "license": "Apache-2.0",
  "keywords": [
    "pdf",
    "documents",
    "ocr",
    "tables",
    "mcp"
  ],
  "logo": ".claude-plugin/icon.png",
  "variables": {
    "type": "object",
    "properties": {
      "MDFI_API_KEY": {
        "type": "string",
        "title": "mdfi API key",
        "description": "From the Connect page of your mdfi dashboard (app.mdfi.ai)"
      }
    },
    "required": [
      "MDFI_API_KEY"
    ]
  },
  "mcpServers": {
    "mdfi": {
      "command": "uvx",
      "args": [
        "mdfi-connect"
      ],
      "env": {
        "MDFI_API_KEY": "${MDFI_API_KEY}"
      }
    }
  }
}
