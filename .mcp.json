{
  "mcpServers": {
    "mdfi": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "mdfi-connect"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_API_KEY": "${user_config.api_key}"
      }
    }
  }
}
